# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# Anthropic API key for /compose-sentence and /text-to-signs. Empty -> deterministic fallback.
ANTHROPIC_API_KEY=
# Claude model used by api/llm_client.py.
CLAUDE_MODEL=claude-opus-5-5

# Free alternative when ANTHROPIC_API_KEY is empty: Groq (https://console.groq.com, free tier, no card).
# Empty -> deterministic fallback. Text is sent to Groq; it is not stored by default.
GROQ_API_KEY=
# Groq model with strict JSON-schema output: openai/gpt-oss-120b, openai/gpt-oss-20b or qwen/qwen3.8-27b.
GROQ_MODEL=openai/gpt-oss-120b

# Azure Speech key and region for /tts. Empty -> /tts returns 503.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Folder with model.pt and config.json, relative to sign-assistant/.
MODEL_DIR=model/artifacts
