# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# Anthropic API key for /compose-sentence and /text-to-signs. Empty -> deterministic fallback.
ANTHROPIC_API_KEY=
# Claude model used by api/llm_client.py.
CLAUDE_MODEL=claude-opus-5-5

# Azure Speech key and region for /tts. Empty -> /tts returns 503.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Folder with model.pt and config.json, relative to sign-assistant/.
MODEL_DIR=model/artifacts
